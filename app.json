{
  "expo": {
    "name": "weather-cat",
    "slug": "weather-cat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "weathercat",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.weathercat.app",
      "adaptiveIcon": {
        "backgroundColor": "#A8D2F8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치의 날씨를 보여주기 위해 위치 권한이 필요합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#A8D2F8",
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "cover",
          "imageWidth": 200
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "WeatherCatWidget",
              "label": "Weather Cat",
              "minWidth": "60dp",
              "minHeight": "60dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "description": "설정한 지역의 현재 날씨를 고양이로 보여줍니다",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
