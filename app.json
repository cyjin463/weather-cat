{
  "expo": {
    "name": "WeatherCat",
    "slug": "WeatherCat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash-icon.png",
    "scheme": "weathercat",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.weathercat.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#A8D2F8",
        "foregroundImage": "./assets/images/splash-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/splash-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치의 날씨를 보여주기 위해 위치 권한이 필요합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#A8D2F8",
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "WeatherCatWidget",
              "label": "Weather Cat",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "description": "고양이가 날씨를 알려줘요!",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.weathercat.app"
    }
  }
}
