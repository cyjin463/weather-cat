    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:android:preview": "eas build -p android --profile preview",
    "build:android:production": "eas build -p android --profile production",
    "build:android:production:clean": "eas build -p android --profile production --clear-cache",
    "submit:android": "eas submit -p android --profile production",
    "analyze:js": "EXPO_ATLAS=true expo export --platform android",
    "analyze:js:open": "expo-atlas .expo/atlas.jsonl",
    "analyze:js:dev": "EXPO_ATLAS=true expo start --no-dev"
